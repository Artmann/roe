/target

# .NET build output inside C# test fixtures — never source, always regenerable
tests/fixtures/**/bin/
tests/fixtures/**/obj/

# insta pending-review diffs
*.snap.new

# static analysis output — cargo llvm-cov, cargo mutants, clippy-sarif
/lcov.info
/mutants.out/
/mutants.out.old/
/results.sarif

# packaging build output — assembled by CI at release time
packaging/npm/build/
packaging/nuget/bin/
packaging/nuget/binaries/
packaging/nuget/obj/
